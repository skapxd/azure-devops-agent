{
  "name": "@skapxd/azure-devops-agent",
  "version": "0.2.0",
  "description": "Azure DevOps desde la terminal: work items, trazabilidad y contexto autodetectado del git remote",
  "keywords": [
    "azure-devops",
    "azure-boards",
    "cli",
    "agent-skill",
    "work-items",
    "trazabilidad"
  ],
  "homepage": "https://github.com/skapxd/azure-devops-agent#readme",
  "bugs": {
    "url": "https://github.com/skapxd/azure-devops-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skapxd/azure-devops-agent.git"
  },
  "license": "MIT",
  "author": "skapxd",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "azure-devops-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "security:audit": "pnpm audit --audit-level low",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@skapxd/result": "^2.0.1",
    "commander": "^15.0.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@skapxd/lint-agent": "^1.5.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
