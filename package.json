{
  "name": "@skapxd/azure-devops-agent",
  "version": "0.1.0",
  "description": "Azure DevOps desde la terminal: work items, trazabilidad y contexto autodetectado del git remote",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsup",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "security:audit": "pnpm audit --audit-level low",
    "test": "pnpm run build && tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@skapxd/lint-agent": "^1.5.0",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "license": "MIT",
  "dependencies": {
    "@skapxd/result": "^2.0.1",
    "commander": "^15.0.0",
    "ts-pattern": "^5.9.0"
  },
  "bin": {
    "azure-devops-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md"
  ],
  "keywords": [
    "azure-devops",
    "azure-boards",
    "cli",
    "agent-skill",
    "work-items",
    "trazabilidad"
  ]
}
