{
  "name": "azure-devops-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Skill para trabajar con Azure DevOps desde la terminal",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "skapxd-lint . --yes --include-tests",
    "lint:fix": "skapxd-lint . --yes --include-tests --fix",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "audit": "pnpm audit --audit-level low"
  },
  "devDependencies": {
    "@skapxd/lint-agent": "^1.5.0",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "license": "MIT"
}
